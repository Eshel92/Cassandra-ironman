.PHONY: all create-clusters wait-ready submariner cert-manager k8ssandra \
        cassandra cassandra-clientconfig status fix-ports clean help

# ─── Config ───────────────────────────────────────────────────────────────────
DC1      := sub-dc1
DC2      := sub-dc2
CTX1     := kind-sub-dc1
CTX2     := kind-sub-dc2
HELM     := helm
KUBECTL  := kubectl
KIND     := kind
SUBCTL   := $(HOME)/.local/bin/subctl

# ─── Default target ───────────────────────────────────────────────────────────
all: create-clusters wait-ready submariner cert-manager k8ssandra cassandra-clientconfig cassandra
	@echo ""
	@echo "=== Submariner setup complete! ==="
	@echo "Run 'make -f Makefile.submariner status' to check everything."

# ─── Phase 1: Create clusters (default CNI - kindnet) ───────────────────────
create-clusters:
	@echo ">>> Creating kind clusters..."
	$(KIND) create cluster --name $(DC1) --config kind-sub-dc1.yaml
	$(KIND) create cluster --name $(DC2) --config kind-sub-dc2.yaml
	@echo ">>> Clusters created."

# ─── Phase 2: Wait for nodes to be Ready ────────────────────────────────────
wait-ready:
	@echo ">>> Waiting for nodes to be Ready..."
	$(KUBECTL) wait --for=condition=Ready node --all --context $(CTX1) --timeout=120s
	$(KUBECTL) wait --for=condition=Ready node --all --context $(CTX2) --timeout=120s
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)

# ─── Phase 3: Deploy Submariner ─────────────────────────────────────────────
submariner:
	@echo ">>> Deploying Submariner broker on $(DC1)..."
	$(SUBCTL) deploy-broker --context $(CTX1)
	@echo ">>> Joining $(DC1) to the broker..."
	$(SUBCTL) join broker-info.subm --context $(CTX1) --clusterid $(DC1) --natt=false --check-broker-certificate=false
	@echo ">>> Joining $(DC2) to the broker..."
	$(SUBCTL) join broker-info.subm --context $(CTX2) --clusterid $(DC2) --natt=false --check-broker-certificate=false
	@echo ">>> Patching broker URL for in-cluster access..."
	@DC1_IP=$$(docker inspect $(DC1)-control-plane --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}') && \
	$(KUBECTL) patch submariner submariner -n submariner-operator --context $(CTX1) \
		--type merge -p "{\"spec\":{\"brokerK8sApiServer\":\"$${DC1_IP}:6443\"}}" && \
	$(KUBECTL) patch submariner submariner -n submariner-operator --context $(CTX2) \
		--type merge -p "{\"spec\":{\"brokerK8sApiServer\":\"$${DC1_IP}:6443\"}}"
	@echo ">>> Waiting for Submariner to be ready..."
	$(KUBECTL) rollout status daemonset/submariner-gateway -n submariner-operator --context $(CTX1) --timeout=180s
	$(KUBECTL) rollout status daemonset/submariner-gateway -n submariner-operator --context $(CTX2) --timeout=180s
	$(KUBECTL) rollout status daemonset/submariner-routeagent -n submariner-operator --context $(CTX1) --timeout=120s
	$(KUBECTL) rollout status daemonset/submariner-routeagent -n submariner-operator --context $(CTX2) --timeout=120s
	@echo ">>> Verifying Submariner connectivity..."
	$(SUBCTL) show connections --context $(CTX1)

# ─── Phase 4: Install cert-manager ──────────────────────────────────────────
cert-manager:
	@echo ">>> Installing cert-manager on $(DC1)..."
	$(HELM) repo add jetstack https://charts.jetstack.io 2>/dev/null || true
	$(HELM) repo update jetstack
	$(HELM) install cert-manager jetstack/cert-manager \
		--kube-context $(CTX1) \
		--namespace cert-manager \
		--create-namespace \
		--set crds.enabled=true
	@echo ">>> Installing cert-manager on $(DC2)..."
	$(HELM) install cert-manager jetstack/cert-manager \
		--kube-context $(CTX2) \
		--namespace cert-manager \
		--create-namespace \
		--set crds.enabled=true
	@echo ">>> Waiting for cert-manager to be ready..."
	$(KUBECTL) rollout status deployment/cert-manager -n cert-manager --context $(CTX1) --timeout=120s
	$(KUBECTL) rollout status deployment/cert-manager -n cert-manager --context $(CTX2) --timeout=120s

# ─── Phase 5: Install k8ssandra operator ────────────────────────────────────
k8ssandra:
	@echo ">>> Installing k8ssandra-operator on $(DC1)..."
	$(HELM) repo add k8ssandra https://helm.k8ssandra.io/stable 2>/dev/null || true
	$(HELM) repo update k8ssandra
	$(HELM) install k8ssandra-operator k8ssandra/k8ssandra-operator \
		--kube-context $(CTX1) \
		--namespace k8ssandra-operator \
		--create-namespace
	@echo ">>> Installing k8ssandra-operator on $(DC2)..."
	$(HELM) install k8ssandra-operator k8ssandra/k8ssandra-operator \
		--kube-context $(CTX2) \
		--namespace k8ssandra-operator \
		--create-namespace
	@echo ">>> Waiting for k8ssandra-operator to be ready..."
	$(KUBECTL) rollout status deployment/k8ssandra-operator -n k8ssandra-operator --context $(CTX1) --timeout=180s
	$(KUBECTL) rollout status deployment/k8ssandra-operator -n k8ssandra-operator --context $(CTX2) --timeout=180s

# ─── Phase 6: Create ClientConfig for cross-cluster access ──────────────────
cassandra-clientconfig:
	@echo ">>> Creating kubeconfig secret for $(DC2) on $(DC1)..."
	@DC2_CA=$$($(KUBECTL) config view --raw -o jsonpath='{.clusters[?(@.name=="$(CTX2)")].cluster.certificate-authority-data}') && \
	DC2_CERT=$$($(KUBECTL) config view --raw -o jsonpath='{.users[?(@.name=="$(CTX2)")].user.client-certificate-data}') && \
	DC2_KEY=$$($(KUBECTL) config view --raw -o jsonpath='{.users[?(@.name=="$(CTX2)")].user.client-key-data}') && \
	DC2_IP=$$(docker inspect $(DC2)-control-plane --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}') && \
	cat <<-KUBECONFIG > /tmp/dc2-kubeconfig.yaml && \
	apiVersion: v1 \
	kind: Config \
	clusters: \
	- cluster: \
	    certificate-authority-data: $${DC2_CA} \
	    server: https://$${DC2_IP}:6443 \
	  name: $(CTX2) \
	contexts: \
	- context: \
	    cluster: $(CTX2) \
	    user: $(CTX2) \
	  name: $(CTX2) \
	current-context: $(CTX2) \
	users: \
	- name: $(CTX2) \
	  user: \
	    client-certificate-data: $${DC2_CERT} \
	    client-key-data: $${DC2_KEY} \
	KUBECONFIG
	$(KUBECTL) create secret generic sub-dc2-kubeconfig \
		--from-file=kubeconfig=/tmp/dc2-kubeconfig.yaml \
		-n k8ssandra-operator \
		--context $(CTX1) && \
	rm -f /tmp/dc2-kubeconfig.yaml

# ─── Phase 7: Deploy Cassandra Multi-DC ─────────────────────────────────────
cassandra:
	@echo ">>> Deploying Cassandra multi-DC cluster..."
	$(KUBECTL) apply -f cassandra-multidc-submariner.yaml --context $(CTX1)
	@echo ">>> Cassandra is deploying (takes 5-10 min). Watch with:"
	@echo "    kubectl get pods -n k8ssandra-operator -w --context $(CTX1)"
	@echo "    kubectl get pods -n k8ssandra-operator -w --context $(CTX2)"

# ─── Status ──────────────────────────────────────────────────────────────────
status:
	@echo "=== Nodes ==="
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)
	@echo ""
	@echo "=== Submariner connections ==="
	$(SUBCTL) show connections --context $(CTX1) 2>/dev/null || echo "(submariner not installed)"
	@echo ""
	@echo "=== Submariner endpoints ==="
	$(SUBCTL) show endpoints --context $(CTX1) 2>/dev/null || echo "(submariner not installed)"
	@echo ""
	@echo "=== Cassandra pods (dc1) ==="
	$(KUBECTL) get pods -n k8ssandra-operator --context $(CTX1) 2>/dev/null || echo "(not deployed yet)"
	@echo ""
	@echo "=== Cassandra pods (dc2) ==="
	$(KUBECTL) get pods -n k8ssandra-operator --context $(CTX2) 2>/dev/null || echo "(not deployed yet)"
	@echo ""
	@echo "=== Cassandra nodetool status ==="
	@$(KUBECTL) exec cassandra-cluster-dc1-default-sts-0 -c cassandra \
		-n k8ssandra-operator --context $(CTX1) -- nodetool status 2>/dev/null \
		|| echo "(cassandra not ready yet)"

# ─── Utilities ───────────────────────────────────────────────────────────────
fix-ports:
	@echo ">>> Fixing Docker Desktop port proxy..."
	docker stop $(DC1)-control-plane $(DC2)-control-plane
	docker start $(DC1)-control-plane $(DC2)-control-plane
	@echo ">>> Waiting 10s for API servers..."
	@sleep 10
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)

clean:
	@echo ">>> Deleting clusters..."
	$(KIND) delete cluster --name $(DC1) || true
	$(KIND) delete cluster --name $(DC2) || true
	rm -f broker-info.subm
	@echo ">>> Done. Run 'make -f Makefile.submariner all' to redeploy."

help:
	@echo ""
	@echo "Cassandra Multi-DC on Kind + Submariner"
	@echo ""
	@echo "Usage: make -f Makefile.submariner <target>"
	@echo ""
	@echo "Targets:"
	@echo "  all                Full setup from scratch"
	@echo "  create-clusters    Create kind clusters (default CNI)"
	@echo "  wait-ready         Wait for nodes to be Ready"
	@echo "  submariner         Deploy Submariner broker + join clusters"
	@echo "  cert-manager       Install cert-manager"
	@echo "  k8ssandra          Install k8ssandra-operator"
	@echo "  cassandra          Deploy Cassandra multi-DC"
	@echo "  status             Show cluster status"
	@echo "  fix-ports          Fix Docker port proxy after WiFi/sleep"
	@echo "  clean              Delete clusters"
	@echo ""
