.PHONY: all create-clusters cilium wait-cilium clustermesh cert-manager k8ssandra \
        cassandra cassandra-clientconfig status fix-ports clean help

# ─── Config ───────────────────────────────────────────────────────────────────
DC1      := dc1
DC2      := dc2
CTX1     := kind-dc1
CTX2     := kind-dc2
HELM     := helm
KUBECTL  := kubectl
CILIUM   := cilium
KIND     := kind

# ─── Default target ───────────────────────────────────────────────────────────
all: create-clusters cilium wait-cilium clustermesh cert-manager k8ssandra cassandra-clientconfig cassandra
	@echo ""
	@echo "=== Cilium setup complete! ==="
	@echo "Run 'make -f Makefile.cilium status' to check everything."

# ─── Phase 1: Create clusters (CNI disabled, Cilium will be the CNI) ────────
create-clusters:
	@echo ">>> Creating kind clusters..."
	$(KIND) create cluster --name $(DC1) --config kind-dc1.yaml
	$(KIND) create cluster --name $(DC2) --config kind-dc2.yaml
	@echo ">>> Clusters created (nodes NotReady until Cilium is installed)"

# ─── Phase 2: Install Cilium CNI ────────────────────────────────────────────
cilium:
	@echo ">>> Installing Cilium on $(DC1)..."
	$(HELM) repo add cilium https://helm.cilium.io/ 2>/dev/null || true
	$(HELM) repo update cilium
	$(HELM) install cilium cilium/cilium \
		--kube-context $(CTX1) \
		--namespace kube-system \
		--set cluster.name=$(DC1) \
		--set cluster.id=1 \
		--set ipam.mode=kubernetes \
		--set operator.replicas=1 \
		--set hubble.relay.enabled=true \
		--set hubble.ui.enabled=true
	@echo ">>> Installing Cilium on $(DC2)..."
	$(HELM) install cilium cilium/cilium \
		--kube-context $(CTX2) \
		--namespace kube-system \
		--set cluster.name=$(DC2) \
		--set cluster.id=2 \
		--set ipam.mode=kubernetes \
		--set operator.replicas=1 \
		--set hubble.relay.enabled=true \
		--set hubble.ui.enabled=true

# ─── Phase 3: Wait for Cilium ──────────────────────────────────────────────
wait-cilium:
	@echo ">>> Waiting for Cilium to be ready on $(DC1)..."
	$(CILIUM) status --context $(CTX1) --wait
	@echo ">>> Waiting for Cilium to be ready on $(DC2)..."
	$(CILIUM) status --context $(CTX2) --wait
	@echo ">>> Both nodes should now be Ready:"
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)

# ─── Phase 4: Enable ClusterMesh ───────────────────────────────────────────
clustermesh:
	@echo ">>> Enabling ClusterMesh on $(DC1)..."
	$(CILIUM) clustermesh enable --context $(CTX1) --service-type NodePort
	@echo ">>> Enabling ClusterMesh on $(DC2)..."
	$(CILIUM) clustermesh enable --context $(CTX2) --service-type NodePort
	@echo ">>> Waiting for ClusterMesh API servers to be ready..."
	$(KUBECTL) rollout status deployment/clustermesh-apiserver -n kube-system --context $(CTX1) --timeout=120s
	$(KUBECTL) rollout status deployment/clustermesh-apiserver -n kube-system --context $(CTX2) --timeout=120s
	@echo ">>> Connecting clusters..."
	$(CILIUM) clustermesh connect --context $(CTX1) --destination-context $(CTX2) --allow-mismatching-ca
	@echo ">>> Restarting Cilium agents to pick up ClusterMesh config..."
	$(KUBECTL) rollout restart daemonset/cilium -n kube-system --context $(CTX1)
	$(KUBECTL) rollout restart daemonset/cilium -n kube-system --context $(CTX2)
	$(KUBECTL) rollout status daemonset/cilium -n kube-system --context $(CTX1) --timeout=120s
	$(KUBECTL) rollout status daemonset/cilium -n kube-system --context $(CTX2) --timeout=120s
	@echo ">>> Verifying ClusterMesh..."
	$(CILIUM) clustermesh status --context $(CTX1) --wait

# ─── Phase 5: Install cert-manager ─────────────────────────────────────────
cert-manager:
	@echo ">>> Installing cert-manager on $(DC1)..."
	$(HELM) repo add jetstack https://charts.jetstack.io 2>/dev/null || true
	$(HELM) repo update jetstack
	$(HELM) install cert-manager jetstack/cert-manager \
		--kube-context $(CTX1) \
		--namespace cert-manager \
		--create-namespace \
		--set crds.enabled=true
	@echo ">>> Installing cert-manager on $(DC2)..."
	$(HELM) install cert-manager jetstack/cert-manager \
		--kube-context $(CTX2) \
		--namespace cert-manager \
		--create-namespace \
		--set crds.enabled=true
	@echo ">>> Waiting for cert-manager to be ready..."
	$(KUBECTL) rollout status deployment/cert-manager -n cert-manager --context $(CTX1) --timeout=120s
	$(KUBECTL) rollout status deployment/cert-manager -n cert-manager --context $(CTX2) --timeout=120s

# ─── Phase 6: Install k8ssandra operator ───────────────────────────────────
k8ssandra:
	@echo ">>> Installing k8ssandra-operator on $(DC1)..."
	$(HELM) repo add k8ssandra https://helm.k8ssandra.io/stable 2>/dev/null || true
	$(HELM) repo update k8ssandra
	$(HELM) install k8ssandra-operator k8ssandra/k8ssandra-operator \
		--kube-context $(CTX1) \
		--namespace k8ssandra-operator \
		--create-namespace
	@echo ">>> Installing k8ssandra-operator on $(DC2)..."
	$(HELM) install k8ssandra-operator k8ssandra/k8ssandra-operator \
		--kube-context $(CTX2) \
		--namespace k8ssandra-operator \
		--create-namespace
	@echo ">>> Waiting for k8ssandra-operator to be ready..."
	$(KUBECTL) rollout status deployment/k8ssandra-operator -n k8ssandra-operator --context $(CTX1) --timeout=180s
	$(KUBECTL) rollout status deployment/k8ssandra-operator -n k8ssandra-operator --context $(CTX2) --timeout=180s

# ─── Phase 7: Create ClientConfig for cross-cluster access ─────────────────
cassandra-clientconfig:
	@echo ">>> Creating kubeconfig secret for $(DC2) on $(DC1)..."
	@DC2_CA=$$($(KUBECTL) config view --raw -o jsonpath='{.clusters[?(@.name=="$(CTX2)")].cluster.certificate-authority-data}') && \
	DC2_CERT=$$($(KUBECTL) config view --raw -o jsonpath='{.users[?(@.name=="$(CTX2)")].user.client-certificate-data}') && \
	DC2_KEY=$$($(KUBECTL) config view --raw -o jsonpath='{.users[?(@.name=="$(CTX2)")].user.client-key-data}') && \
	DC2_IP=$$(docker inspect $(DC2)-control-plane --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}') && \
	cat <<-KUBECONFIG > /tmp/dc2-kubeconfig.yaml && \
	apiVersion: v1 \
	kind: Config \
	clusters: \
	- cluster: \
	    certificate-authority-data: $${DC2_CA} \
	    server: https://$${DC2_IP}:6443 \
	  name: $(CTX2) \
	contexts: \
	- context: \
	    cluster: $(CTX2) \
	    user: $(CTX2) \
	  name: $(CTX2) \
	current-context: $(CTX2) \
	users: \
	- name: $(CTX2) \
	  user: \
	    client-certificate-data: $${DC2_CERT} \
	    client-key-data: $${DC2_KEY} \
	KUBECONFIG
	$(KUBECTL) create secret generic dc2-kubeconfig \
		--from-file=kubeconfig=/tmp/dc2-kubeconfig.yaml \
		-n k8ssandra-operator \
		--context $(CTX1) && \
	rm -f /tmp/dc2-kubeconfig.yaml

# ─── Phase 8: Deploy Cassandra Multi-DC ────────────────────────────────────
cassandra:
	@echo ">>> Deploying Cassandra multi-DC cluster..."
	$(KUBECTL) apply -f cassandra-multidc.yaml --context $(CTX1)
	@echo ">>> Cassandra is deploying (takes 5-10 min). Watch with:"
	@echo "    kubectl get pods -n k8ssandra-operator -w --context $(CTX1)"
	@echo "    kubectl get pods -n k8ssandra-operator -w --context $(CTX2)"

# ─── Status ────────────────────────────────────────────────────────────────
status:
	@echo "=== Nodes ==="
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)
	@echo ""
	@echo "=== Cilium ==="
	$(CILIUM) status --context $(CTX1) 2>/dev/null | head -10
	@echo ""
	@echo "=== ClusterMesh ==="
	$(CILIUM) clustermesh status --context $(CTX1) 2>/dev/null
	@echo ""
	@echo "=== Cassandra pods (dc1) ==="
	$(KUBECTL) get pods -n k8ssandra-operator --context $(CTX1) 2>/dev/null || echo "(not deployed yet)"
	@echo ""
	@echo "=== Cassandra pods (dc2) ==="
	$(KUBECTL) get pods -n k8ssandra-operator --context $(CTX2) 2>/dev/null || echo "(not deployed yet)"
	@echo ""
	@echo "=== Cassandra nodetool status ==="
	@$(KUBECTL) exec cassandra-cluster-dc1-default-sts-0 -c cassandra \
		-n k8ssandra-operator --context $(CTX1) -- nodetool status 2>/dev/null \
		|| echo "(cassandra not ready yet)"

# ─── Utilities ─────────────────────────────────────────────────────────────
fix-ports:
	@echo ">>> Fixing Docker Desktop port proxy..."
	docker stop $(DC1)-control-plane $(DC2)-control-plane
	docker start $(DC1)-control-plane $(DC2)-control-plane
	@echo ">>> Waiting 10s for API servers..."
	@sleep 10
	$(KUBECTL) get nodes --context $(CTX1)
	$(KUBECTL) get nodes --context $(CTX2)

clean:
	@echo ">>> Deleting clusters..."
	$(KIND) delete cluster --name $(DC1) || true
	$(KIND) delete cluster --name $(DC2) || true
	@echo ">>> Done. Run 'make -f Makefile.cilium all' to redeploy."

help:
	@echo ""
	@echo "Cassandra Multi-DC on Kind + Cilium ClusterMesh"
	@echo ""
	@echo "Usage: make -f Makefile.cilium <target>"
	@echo ""
	@echo "Targets:"
	@echo "  all                Full setup from scratch"
	@echo "  create-clusters    Create kind clusters (CNI disabled)"
	@echo "  cilium             Install Cilium CNI"
	@echo "  wait-cilium        Wait for Cilium to be ready"
	@echo "  clustermesh        Enable and connect ClusterMesh"
	@echo "  cert-manager       Install cert-manager"
	@echo "  k8ssandra          Install k8ssandra-operator"
	@echo "  cassandra          Deploy Cassandra multi-DC"
	@echo "  status             Show cluster status"
	@echo "  fix-ports          Fix Docker port proxy after WiFi/sleep"
	@echo "  clean              Delete clusters"
	@echo ""
